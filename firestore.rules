rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules → Publish.
// Every client signs in anonymously, so "signed in" just means "uses the app".
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    // Chat messages: anyone in the app can read and post; nobody can edit
    // or delete. The timestamp must come from the server.
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['user', 'text', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['user', 'text', 'uid', 'createdAt'])
        && validName(request.resource.data.user)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2200
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Push notification devices; the document id is the Expo push token.
    match /devices/{token} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['token', 'user', 'mode', 'uid'])
        && request.resource.data.keys().hasOnly(['token', 'user', 'mode', 'platform', 'uid', 'updatedAt'])
        && request.resource.data.token == token
        && validName(request.resource.data.user)
        && request.resource.data.mode in ['all', 'mentions', 'off']
        && request.resource.data.uid == request.auth.uid;
      // Any client may delete, so senders can remove tokens that Expo
      // reports as no longer registered.
      allow delete: if signedIn();
    }
  }
}
